<style>
  /* Basic Reset & Typography */
  .tutorial-wrapper {
    max-width: 800px;
    margin: 3rem auto;
    padding: 0 1rem;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    color: #334155;
  }

  /* Header Section */
  .tutorial-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    border-bottom: 2px solid #f1f5f9;
    padding-bottom: 1.5rem;
    margin-bottom: 2rem;
  }

  .tutorial-header h1 {
    font-size: 1.85rem;
    color: #0f172a;
    margin: 0 0 0.25rem 0;
  }

  .tutorial-header p {
    margin: 0;
    color: #64748b;
  }

  .lesson-badge {
    background: #eef2ff;
    color: #4f46e5;
    padding: 0.4rem 0.8rem;
    border-radius: 99px;
    font-size: 0.85rem;
    font-weight: 600;
  }

  /* Lesson List Item */
  .lesson-link {
    display: flex;
    justify-content: space-between;
    align-items: center;
    text-decoration: none;
    padding: 1.5rem;
    border-radius: 12px;
    transition: all 0.2s ease;
    border: 1px solid transparent;
  }

  .lesson-link:hover {
    background: #f8fafc;
    border-color: #e2e8f0;
    transform: translateY(-2px);
  }

  .lesson-section {
    display: block;
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05rem;
    color: #6366f1;
    margin-bottom: 0.35rem;
  }

  .lesson-title {
    margin: 0;
    font-size: 1.1rem;
    color: #1e293b;
  }

  .lesson-order {
    color: #94a3b8;
    margin-right: 0.5rem;
  }

  /* Custom Button UI */
  .start-btn {
    font-size: 0.9rem;
    font-weight: 600;
    color: #4f46e5;
    border: 1.5px solid #e2e8f0;
    padding: 0.5rem 1rem;
    border-radius: 8px;
    background: white;
    transition: background 0.2s;
  }

  .lesson-link:hover .start-btn {
    background: #4f46e5;
    color: white;
    border-color: #4f46e5;
  }

  .empty-msg {
    text-align: center;
    padding: 3rem;
    background: #f8fafc;
    border-radius: 12px;
    color: #94a3b8;
  }
</style>

<div class="tutorial-wrapper">
  <header class="tutorial-header">
    <div>
      <h1>Rails Task Manager</h1>
      <p>Master Ruby on Rails by building a production-ready app.</p>
    </div>
    <span class="lesson-badge"><%= @lessons.count %> Lessons</span>
  </header>

  <div class="lesson-container">
    <% @lessons.each do |lesson| %>
      <%= link_to lesson_path(lesson), class: "lesson-link" do %>
        <div>
          <span class="lesson-section"><%= lesson.section %></span>
          <h3 class="lesson-title">
            <span class="lesson-order"><%= lesson.order %>.</span><%= lesson.title %>
          </h3>
        </div>
        <div class="start-btn">Start Lesson</div>
      <% end %>
    <% end %>
  </div>

  <% if @lessons.empty? %>
    <div class="empty-msg">
      <p>No lessons available yet. Check back soon!</p>
    </div>
  <% end %>
</div>
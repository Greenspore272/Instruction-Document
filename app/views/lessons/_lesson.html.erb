<style>
  /* The Main Card Container */
  .lesson-card {
    max-width: 800px;
    margin: 40px auto;
    background: #ffffff;
    border-radius: 16px;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08); /* Subtle depth */
    overflow: hidden;
    font-family: -apple-system, BlinkMacSystemFont, "Inter", sans-serif;
    border: 1px solid #edf2f7;
  }

  /* Header/Title Area */
  .lesson-header {
    padding: 30px 40px;
    background: #f8fafc;
    border-bottom: 1px solid #edf2f7;
    position: relative;
  }

  /* Vertical Accent Bar */
  .lesson-header::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 6px;
    background: #4f46e5; /* Professional Indigo */
  }

  .label-sm {
    display: block;
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    color: #94a3b8;
    margin-bottom: 8px;
  }

  .display-title {
    margin: 0;
    font-size: 2rem;
    font-weight: 800;
    color: #0f172a;
    line-height: 1.2;
  }

  /* Content Body */
  .lesson-body {
    padding: 40px;
  }

  .rich-content {
    font-size: 1.15rem;
    line-height: 1.8;
    color: #334155;
    white-space: pre-line;
  }

  /* Footer/Meta Info Grid */
  .lesson-footer {
    padding: 20px 40px;
    background: #fcfcfd;
    border-top: 1px solid #edf2f7;
    display: flex;
    gap: 40px;
  }

  .meta-item strong {
    display: block;
    font-size: 11px;
    color: #64748b;
    text-transform: uppercase;
    margin-bottom: 4px;
  }

  .meta-value {
    font-weight: 600;
    color: #1e293b;
  }

  .step-pill {
    background: #e0e7ff;
    color: #4338ca;
    padding: 2px 10px;
    border-radius: 6px;
    font-family: monospace;
  }
</style>

<div id="<%= dom_id lesson %>" class="lesson-card">
  
  <div class="lesson-header">
    <strong class="label-sm">Title</strong>
    <h1 class="display-title"><%= lesson.title %></h1>
  </div>

  <div class="lesson-body">
    <strong class="label-sm">Lesson Content</strong>
    <div class="rich-content">
      <%= lesson.content %>
    </div>
  </div>

  <div class="lesson-footer">
    <div class="meta-item">
      <strong>Section</strong>
      <span class="meta-value"><%= lesson.section %></span>
    </div>
    <div class="meta-item">
      <strong>Order</strong>
      <span class="meta-value step-pill">Step #<%= lesson.order %></span>
    </div>
  </div>

</div>